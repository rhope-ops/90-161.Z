        ]
      },
      "type": "Compose",
      "inputs": "@concat(if(contains(string(actions('READ1_inbox')?['outputs']?['body']), 'T9 S5 '), '+inbox', ''), if(contains(string(actions('READ1_junk')?['outputs']?['body']), 'T9 S5 '), '+junk', ''), if(contains(string(actions('READ1_sent')?['outputs']?['body']), 'T9 S5 '), '+sent', ''), if(contains(if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), '', string(actions('READ1_box')?['outputs']?['body'])), 'T9 S5 '), '+boxsent', ''))"
    },
    "READ1_where_S6": {
