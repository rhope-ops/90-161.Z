{
  "displayName": "90161Z F06 Hold and Resume r2",
  "description": "When a PFM Publications row goes On Hold: records Held Since, logs it and tells the open endorsers once. When it leaves On Hold: moves each open suspense out by the weekdays held (logged as an extension, DAFMAN 90-161 5.2.1), clears Held Since and tells the endorsers the new date. When it is Cancelled: logs it once and tells the open endorsers no response is needed. Test mode sends every e-mail to the PFM only; a failed step e-mails the PFM. PFM D1-D3, 2026-11-14. Reads Flows paused, Test mode and Shared mailbox once at the start from PFM Settings rows (missing or empty: No, Yes and none). No subject prefix in test mode (PFM 16 Nov 26).",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Try": {
      "runAfter": {},
      "type": "Scope",
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Settings (pfm_ListSettings)')",
              "$top": 500
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "R27 (PFM 14 Nov 26): the flow values are rows of PFM Settings, read once at the start. A missing or empty row gives the default: Flows paused No, Test mode Yes (fail-safe), reminder 5, escalation 3, suspense 20, shared mailbox empty."
        },
        "Filter_FlowsPaused": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "where": "@equals(item()?['Title'], 'FlowsPaused')"
          }
        },
        "Setting_flows_paused": {
          "runAfter": {
            "Filter_FlowsPaused": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(toLower(trim(coalesce(if(empty(body('Filter_FlowsPaused')), '', first(body('Filter_FlowsPaused'))?['SettingValue']), ''))), 'yes')"
        },
        "Filter_TestMode": {
          "runAfter": {
            "Setting_flows_paused": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "where": "@equals(item()?['Title'], 'TestMode')"
          }
        },
        "Test_mode": {
          "runAfter": {
            "Filter_TestMode": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@not(equals(toLower(trim(coalesce(if(empty(body('Filter_TestMode')), '', first(body('Filter_TestMode'))?['SettingValue']), ''))), 'no'))"
        },
        "Filter_SharedMailbox": {
          "runAfter": {
            "Test_mode": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "where": "@equals(item()?['Title'], 'SharedMailbox')"
          }
        },
        "Setting_shared_mailbox": {
          "runAfter": {
            "Filter_SharedMailbox": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@trim(coalesce(if(empty(body('Filter_SharedMailbox')), '', first(body('Filter_SharedMailbox'))?['SettingValue']), ''))"
        },
        "If_flows_paused": {
          "runAfter": {
            "Setting_shared_mailbox": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@outputs('Setting_flows_paused')",
              true
            ]
          },
          "actions": {
            "Stop_flows_are_paused": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Today": {
          "runAfter": {
            "If_flows_paused": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd')"
        },
        "Get_open_rows": {
          "runAfter": {
            "Today": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
              "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and EndorsementStatus eq ''Not Started''')",
              "$top": 500
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Open_rows_with_endorser": {
          "runAfter": {
            "Get_open_rows": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_open_rows')?['value']",
            "where": "@not(empty(item()?['Endorser']?['Email']))"
          }
        },
        "Open_rows_with_due": {
          "runAfter": {
            "Open_rows_with_endorser": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_open_rows')?['value']",
            "where": "@not(empty(item()?['DueDate']))"
          }
        },
        "If_hold_started": {
          "runAfter": {
            "Open_rows_with_due": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@coalesce(triggerBody()?['ActionStatus']?['Value'], '')",
                  "On Hold"
                ]
              },
              {
                "equals": [
                  "@empty(triggerBody()?['HeldSince'])",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Set_held_since": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/HeldSince": "@outputs('Today')"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Log_hold": {
              "runAfter": {
                "Set_held_since": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                  "item/Title": "@concat('Action Held: P', string(triggerBody()?['ID']))",
                  "item/Publication/Id": "@triggerBody()?['ID']",
                  "item/EventType/Value": "Status Changed",
                  "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                  "item/EventDetails": "@concat('On hold from ', outputs('Today'), '. Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '. Reminders stop until the action resumes.')"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Tell_endorsers_paused": {
              "runAfter": {
                "Log_hold": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Open_rows_with_endorser')",
              "actions": {
                "Mail_to_paused": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@if(outputs('Test_mode'), parameters('Alert e-mail (pfm_AlertEmail)'), items('Tell_endorsers_paused')?['Endorser']?['Email'])"
                },
                "Mail_cc_paused": {
                  "runAfter": {
                    "Mail_to_paused": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(outputs('Test_mode'), '', '')"
                },
                "Mail_note_paused": {
                  "runAfter": {
                    "Mail_cc_paused": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(outputs('Test_mode'), concat('<p><b>TEST MODE</b>: this e-mail went to the alert address only. Intended To: ', items('Tell_endorsers_paused')?['Endorser']?['Email'], '; Cc: ', '', '.</p>'), '')"
                },
                "If_shared_mailbox_paused": {
                  "runAfter": {
                    "Mail_note_paused": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(outputs('Setting_shared_mailbox'))",
                          true
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Send_from_the_owner_paused": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "authentication": "@parameters('$authentication')",
                        "parameters": {
                          "emailMessage/To": "@outputs('Mail_to_paused')",
                          "emailMessage/Cc": "@outputs('Mail_cc_paused')",
                          "emailMessage/Subject": "@concat(concat('Coordination paused: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                          "emailMessage/Body": "@concat(outputs('Mail_note_paused'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' is on hold from ', outputs('Today'), '. You get no reminders while it is on hold. When it resumes, your suspense moves out by the weekdays it was on hold.</p><p>Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                          "emailMessage/Importance": "@'Normal'"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Send_from_the_shared_mailbox_paused": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "connectionName": "shared_office365",
                            "operationId": "SharedMailboxSendEmailV2"
                          },
                          "authentication": "@parameters('$authentication')",
                          "parameters": {
                            "emailMessage/MailboxAddress": "@outputs('Setting_shared_mailbox')",
                            "emailMessage/To": "@outputs('Mail_to_paused')",
                            "emailMessage/Cc": "@outputs('Mail_cc_paused')",
                            "emailMessage/Subject": "@concat(concat('Coordination paused: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                            "emailMessage/Body": "@concat(outputs('Mail_note_paused'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' is on hold from ', outputs('Today'), '. You get no reminders while it is on hold. When it resumes, your suspense moves out by the weekdays it was on hold.</p><p>Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                            "emailMessage/Importance": "@'Normal'"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "If_hold_ended": {
          "runAfter": {
            "If_hold_started": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@coalesce(triggerBody()?['ActionStatus']?['Value'], '')",
                    "On Hold"
                  ]
                }
              },
              {
                "equals": [
                  "@empty(triggerBody()?['HeldSince'])",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Held_from": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@substring(triggerBody()?['HeldSince'], 0, 10)"
            },
            "Held_days": {
              "runAfter": {
                "Held_from": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@max(div(sub(ticks(outputs('Today')), ticks(outputs('Held_from'))), 864000000000), 0)"
            },
            "Held_weekdays": {
              "runAfter": {
                "Held_days": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@range(0, add(outputs('Held_days'), 1))",
                "where": "@and(greater(item(), 0), not(equals(dayOfWeek(addDays(outputs('Held_from'), item())), 0)), not(equals(dayOfWeek(addDays(outputs('Held_from'), item())), 6)))"
              }
            },
            "If_resumed_with_days": {
              "runAfter": {
                "Held_weekdays": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "contains": [
                        "@createArray('On Hold', 'Cancelled', 'Complete')",
                        "@coalesce(triggerBody()?['ActionStatus']?['Value'], '')"
                      ]
                    }
                  },
                  {
                    "greater": [
                      "@length(body('Held_weekdays'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "For_each_open_row": {
                  "runAfter": {},
                  "type": "Foreach",
                  "foreach": "@body('Open_rows_with_due')",
                  "actions": {
                    "If_not_moved_yet": {
                      "runAfter": {},
                      "type": "If",
                      "expression": {
                        "not": {
                          "contains": [
                            "@coalesce(items('For_each_open_row')?['ExtensionRationale'], '')",
                            "@concat('Hold ', outputs('Held_from'), ' to ')"
                          ]
                        }
                      },
                      "actions": {
                        "Base_due": {
                          "runAfter": {},
                          "type": "Compose",
                          "inputs": "@if(and(not(empty(items('For_each_open_row')?['ExtensionDate'])), greater(ticks(substring(coalesce(items('For_each_open_row')?['ExtensionDate'], '0001-01-01'), 0, 10)), ticks(substring(items('For_each_open_row')?['DueDate'], 0, 10)))), substring(coalesce(items('For_each_open_row')?['ExtensionDate'], '0001-01-01'), 0, 10), substring(items('For_each_open_row')?['DueDate'], 0, 10))"
                        },
                        "Base_weekday": {
                          "runAfter": {
                            "Base_due": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose",
                          "inputs": "@addDays(outputs('Base_due'), if(equals(dayOfWeek(outputs('Base_due')), 6), -1, if(equals(dayOfWeek(outputs('Base_due')), 0), -2, 0)), 'yyyy-MM-dd')"
                        },
                        "New_due": {
                          "runAfter": {
                            "Base_weekday": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose",
                          "inputs": "@addDays(outputs('Base_weekday'), add(mul(7, div(length(body('Held_weekdays')), 5)), add(mod(length(body('Held_weekdays')), 5), if(greater(add(dayOfWeek(outputs('Base_weekday')), mod(length(body('Held_weekdays')), 5)), 5), 2, 0))), 'yyyy-MM-dd')"
                        },
                        "Move_suspense": {
                          "runAfter": {
                            "New_due": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PatchItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                              "id": "@items('For_each_open_row')?['ID']",
                              "item/Title": "@items('For_each_open_row')?['Title']",
                              "item/DueDate": "@outputs('New_due')",
                              "item/ExtensionRationale": "@concat(coalesce(items('For_each_open_row')?['ExtensionRationale'], ''), if(empty(items('For_each_open_row')?['ExtensionRationale']), '', ' '), 'Hold ', outputs('Held_from'), ' to ', outputs('Today'), ': suspense moved out ', string(length(body('Held_weekdays'))), ' weekday(s), from ', outputs('Base_due'), ' to ', outputs('New_due'), ' (PFM hold, logged as an extension; DAFMAN 90-161 5.2.1).')"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "If_endorser_resumed": {
                          "runAfter": {
                            "Move_suspense": [
                              "Succeeded"
                            ]
                          },
                          "type": "If",
                          "expression": {
                            "not": {
                              "equals": [
                                "@coalesce(items('For_each_open_row')?['Endorser']?['Email'], '')",
                                ""
                              ]
                            }
                          },
                          "actions": {
                            "Mail_to_resumed": {
                              "runAfter": {},
                              "type": "Compose",
                              "inputs": "@if(outputs('Test_mode'), parameters('Alert e-mail (pfm_AlertEmail)'), items('For_each_open_row')?['Endorser']?['Email'])"
                            },
                            "Mail_cc_resumed": {
                              "runAfter": {
                                "Mail_to_resumed": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(outputs('Test_mode'), '', '')"
                            },
                            "Mail_note_resumed": {
                              "runAfter": {
                                "Mail_cc_resumed": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(outputs('Test_mode'), concat('<p><b>TEST MODE</b>: this e-mail went to the alert address only. Intended To: ', items('For_each_open_row')?['Endorser']?['Email'], '; Cc: ', '', '.</p>'), '')"
                            },
                            "If_shared_mailbox_resumed": {
                              "runAfter": {
                                "Mail_note_resumed": [
                                  "Succeeded"
                                ]
                              },
                              "type": "If",
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@empty(outputs('Setting_shared_mailbox'))",
                                      true
                                    ]
                                  }
                                ]
                              },
                              "actions": {
                                "Send_from_the_owner_resumed": {
                                  "runAfter": {},
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                      "connectionName": "shared_office365",
                                      "operationId": "SendEmailV2"
                                    },
                                    "authentication": "@parameters('$authentication')",
                                    "parameters": {
                                      "emailMessage/To": "@outputs('Mail_to_resumed')",
                                      "emailMessage/Cc": "@outputs('Mail_cc_resumed')",
                                      "emailMessage/Subject": "@concat(concat('Coordination resumed: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                                      "emailMessage/Body": "@concat(outputs('Mail_note_resumed'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' has resumed. Your new suspense is ', outputs('New_due'), '.</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                                      "emailMessage/Importance": "@'Normal'"
                                    }
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Send_from_the_shared_mailbox_resumed": {
                                    "runAfter": {},
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                        "connectionName": "shared_office365",
                                        "operationId": "SharedMailboxSendEmailV2"
                                      },
                                      "authentication": "@parameters('$authentication')",
                                      "parameters": {
                                        "emailMessage/MailboxAddress": "@outputs('Setting_shared_mailbox')",
                                        "emailMessage/To": "@outputs('Mail_to_resumed')",
                                        "emailMessage/Cc": "@outputs('Mail_cc_resumed')",
                                        "emailMessage/Subject": "@concat(concat('Coordination resumed: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                                        "emailMessage/Body": "@concat(outputs('Mail_note_resumed'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' has resumed. Your new suspense is ', outputs('New_due'), '.</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                                        "emailMessage/Importance": "@'Normal'"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Log_resume": {
              "runAfter": {
                "If_resumed_with_days": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                  "item/Title": "@concat('Action Resumed: P', string(triggerBody()?['ID']))",
                  "item/Publication/Id": "@triggerBody()?['ID']",
                  "item/EventType/Value": "Status Changed",
                  "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                  "item/EventDetails": "@concat('Hold ended (', coalesce(triggerBody()?['ActionStatus']?['Value'], ''), ') after ', string(length(body('Held_weekdays'))), ' weekday(s) on hold, from ', outputs('Held_from'), ' to ', outputs('Today'), if(contains(createArray('Cancelled', 'Complete'), coalesce(triggerBody()?['ActionStatus']?['Value'], '')), '. No suspense moved.', concat('. Suspense moved on ', string(length(body('Open_rows_with_due'))), ' open row(s).')))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Clear_held_since": {
              "runAfter": {
                "Log_resume": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/HeldSince": "@null"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "If_cancelled": {
          "runAfter": {
            "If_hold_ended": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@coalesce(triggerBody()?['ActionStatus']?['Value'], '')",
              "Cancelled"
            ]
          },
          "actions": {
            "Get_cancel_log": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                  "$filter": "@concat('Title eq ''Action Cancelled: P', string(triggerBody()?['ID']), '''')",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_not_logged_yet": {
              "runAfter": {
                "Get_cancel_log": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(body('Get_cancel_log')?['value'])",
                  0
                ]
              },
              "actions": {
                "Log_cancel": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                      "item/Title": "@concat('Action Cancelled: P', string(triggerBody()?['ID']))",
                      "item/Publication/Id": "@triggerBody()?['ID']",
                      "item/EventType/Value": "Status Changed",
                      "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                      "item/EventDetails": "@concat('Action cancelled on ', outputs('Today'), '. Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '. The rows stay as the record.')"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Tell_endorsers_cancelled": {
                  "runAfter": {
                    "Log_cancel": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach",
                  "foreach": "@body('Open_rows_with_endorser')",
                  "actions": {
                    "Mail_to_cancelled": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@if(outputs('Test_mode'), parameters('Alert e-mail (pfm_AlertEmail)'), items('Tell_endorsers_cancelled')?['Endorser']?['Email'])"
                    },
                    "Mail_cc_cancelled": {
                      "runAfter": {
                        "Mail_to_cancelled": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(outputs('Test_mode'), '', '')"
                    },
                    "Mail_note_cancelled": {
                      "runAfter": {
                        "Mail_cc_cancelled": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(outputs('Test_mode'), concat('<p><b>TEST MODE</b>: this e-mail went to the alert address only. Intended To: ', items('Tell_endorsers_cancelled')?['Endorser']?['Email'], '; Cc: ', '', '.</p>'), '')"
                    },
                    "If_shared_mailbox_cancelled": {
                      "runAfter": {
                        "Mail_note_cancelled": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@empty(outputs('Setting_shared_mailbox'))",
                              true
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Send_from_the_owner_cancelled": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "SendEmailV2"
                            },
                            "authentication": "@parameters('$authentication')",
                            "parameters": {
                              "emailMessage/To": "@outputs('Mail_to_cancelled')",
                              "emailMessage/Cc": "@outputs('Mail_cc_cancelled')",
                              "emailMessage/Subject": "@concat(concat('Coordination cancelled: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                              "emailMessage/Body": "@concat(outputs('Mail_note_cancelled'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' is cancelled. No response is needed.</p><p>Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                              "emailMessage/Importance": "@'Normal'"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Send_from_the_shared_mailbox_cancelled": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                "connectionName": "shared_office365",
                                "operationId": "SharedMailboxSendEmailV2"
                              },
                              "authentication": "@parameters('$authentication')",
                              "parameters": {
                                "emailMessage/MailboxAddress": "@outputs('Setting_shared_mailbox')",
                                "emailMessage/To": "@outputs('Mail_to_cancelled')",
                                "emailMessage/Cc": "@outputs('Mail_cc_cancelled')",
                                "emailMessage/Subject": "@concat(concat('Coordination cancelled: ', coalesce(triggerBody()?['Title'], 'a publication action')))",
                                "emailMessage/Body": "@concat(outputs('Mail_note_cancelled'), concat('<p>Coordination of ', coalesce(triggerBody()?['Title'], 'a publication action'), ' is cancelled. No response is needed.</p><p>Reason: ', coalesce(triggerBody()?['StatusReason'], 'not given'), '</p><p>This message is sent by the 90-161.Z publications flow.</p>'))",
                                "emailMessage/Importance": "@'Normal'"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "Failed_actions": {
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "Query",
      "inputs": {
        "from": "@result('Try')",
        "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
      }
    },
    "Failure_lines": {
      "runAfter": {
        "Failed_actions": [
          "Succeeded"
        ]
      },
      "type": "Select",
      "inputs": {
        "from": "@body('Failed_actions')",
        "select": "@concat('<li><b>', replace(coalesce(item()?['name'], 'step'), '_', ' '), '</b>: ', coalesce(item()?['error']?['message'], item()?['error']?['code'], 'no error text'), '</li>')"
      }
    },
    "E-mail_the_failure": {
      "runAfter": {
        "Failure_lines": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "authentication": "@parameters('$authentication')",
        "parameters": {
          "emailMessage/To": "@parameters('Alert e-mail (pfm_AlertEmail)')",
          "emailMessage/Subject": "@concat('90-161.Z flow failed: F06 ', coalesce(workflow()?['tags']?['flowDisplayName'], ''))",
          "emailMessage/Body": "@concat('<p>A 90-161.Z flow stopped with an error. Nothing after the failed step ran.</p>', '<p><b>Flow:</b> ', coalesce(workflow()?['tags']?['flowDisplayName'], 'F06'), '<br><b>Started:</b> ', convertTimeZone(utcNow(), 'UTC', 'Central Standard Time', 'dd MMM yy HHmm'), ' Central', '<br><b>Publication row:</b> ', string(triggerBody()?['ID']), '</p>', '<p><b>Failed step:</b></p><ul>', join(body('Failure_lines'), ''), '</ul>', '<p><b>What to do:</b> 1. Open the failed run: <a href=\"https://make.powerautomate.appsplatform.us/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'], '\">run details</a> (or open this flow and its 28-day run history; the failed run has the start time above). 2. Fix the cause the step names (for example a list name or a connection). 3. Select Resubmit on that run: the flow starts again from the beginning and does not repeat what the failed run already did.</p>', '<p>This message is sent by the 90-161.Z publications flow.</p>')",
          "emailMessage/Importance": "High"
        }
      }
    },
    "End_as_failed": {
      "runAfter": {
        "E-mail_the_failure": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "Terminate",
      "inputs": {
        "runStatus": "Failed",
        "runError": {
          "code": "StepFailed",
          "message": "A step failed; the alert address was e-mailed. Fix the cause, then Resubmit this run."
        }
      }
    }
  }
}
