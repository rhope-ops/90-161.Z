              "connectionName": "shared_office365",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "Uri": "@concat('/v1.0/users/', parameters('Shared mailbox (pfm_SharedMailbox)'), '/mailFolders/sentitems/messages?$filter=contains(subject,''', outputs('Tag'), ''')&$select=subject&$top=25')",
              "Method": "GET",
              "ContentType": "application/json"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "READ1_where_S3": {
      "runAfter": {
        "READ1_inbox": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "READ1_junk": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "READ1_sent": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "READ1_hasbox": [
          "Succeeded",
