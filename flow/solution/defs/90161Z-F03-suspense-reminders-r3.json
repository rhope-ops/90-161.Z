{
  "displayName": "90161Z F03 Suspense Reminders r3",
  "description": "Weekdays 07:00 Central. Sets the default suspense (20 working days; Guard and Reserve Applicability at least 30 calendar days) on open PFM Endorsements rows without one, then sends one reminder (5 weekdays before), warning (suspense day) or escalation (3 working days after) e-mail per row and tier, from the shared mailbox when one is set. Skips actions On Hold, Cancelled or Complete. Test mode sends every e-mail to the PFM only; a failed step e-mails the PFM (DAFMAN 90-161 5.2, 5.2.1, 5.2.2, 5.4.3).",
  "workflowKey": "90161Z-F03-suspense-reminders-r2",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "Recurrence_weekdays_0700_Central": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "timeZone": "Central Standard Time",
        "schedule": {
          "weekDays": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "hours": [
            "7"
          ],
          "minutes": [
            0
          ]
        },
        "startTime": "2026-11-16T07:00:00"
      }
    }
  },
  "actions": {
    "If_flows_on": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@equals(toLower(trim(parameters('Flows off (pfm_FlowsOff)'))), 'yes')",
            true
          ]
        }
      },
      "actions": {
        "Try": {
          "runAfter": {},
          "type": "Scope",
          "actions": {
            "Today": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd')"
            },
            "Get_inactive_publications": {
              "runAfter": {
                "Today": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                  "$filter": "ActionStatus eq 'On Hold' or ActionStatus eq 'Cancelled' or ActionStatus eq 'Complete'",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Inactive_ids": {
              "runAfter": {
                "Get_inactive_publications": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Get_inactive_publications')?['value']",
                "select": "@item()?['ID']"
              }
            },
            "Start_day": {
              "runAfter": {
                "Inactive_ids": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@addDays(outputs('Today'), if(equals(dayOfWeek(outputs('Today')), 6), -1, if(equals(dayOfWeek(outputs('Today')), 0), -2, 0)), 'yyyy-MM-dd')"
            },
            "Get_endorsements_without_suspense": {
              "runAfter": {
                "Start_day": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                  "$filter": "EndorsementStatus eq 'Not Started' and DueDate eq null and CoordinationStage ne 'Legal' and (CoordinationRole ne 'Legal' or CoordinationRole eq null)",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              }
            },
            "For_each_endorsement_without_suspense": {
              "runAfter": {
                "Get_endorsements_without_suspense": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Get_endorsements_without_suspense')?['value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "If_publication_active_A": {
                  "runAfter": {},
                  "type": "If",
                  "expression": {
                    "not": {
                      "contains": [
                        "@body('Inactive_ids')",
                        "@items('For_each_endorsement_without_suspense')?['Publication']?['Id']"
                      ]
                    }
                  },
                  "actions": {
                    "Set_default_suspense": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                          "id": "@items('For_each_endorsement_without_suspense')?['ID']",
                          "item/Title": "@items('For_each_endorsement_without_suspense')?['Title']",
                          "item/DueDate": "@if(and(or(equals(items('For_each_endorsement_without_suspense')?['CoordinationRole']?['Value'], 'Guard Applicability'), equals(items('For_each_endorsement_without_suspense')?['CoordinationRole']?['Value'], 'Reserve Applicability')), greater(ticks(addDays(outputs('Today'), 30, 'yyyy-MM-dd')), ticks(addDays(outputs('Start_day'), add(mul(7, div(20, 5)), add(mod(20, 5), if(greater(add(dayOfWeek(outputs('Start_day')), mod(20, 5)), 5), 2, 0))), 'yyyy-MM-dd')))), addDays(outputs('Today'), 30, 'yyyy-MM-dd'), addDays(outputs('Start_day'), add(mul(7, div(20, 5)), add(mod(20, 5), if(greater(add(dayOfWeek(outputs('Start_day')), mod(20, 5)), 5), 2, 0))), 'yyyy-MM-dd'))"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            },
            "Get_open_endorsements": {
              "runAfter": {
                "For_each_endorsement_without_suspense": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                  "$filter": "EndorsementStatus eq 'Not Started' and DueDate ne null",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              }
            },
            "For_each_open_endorsement": {
              "runAfter": {
                "Get_open_endorsements": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Get_open_endorsements')?['value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "If_publication_active_B": {
                  "runAfter": {},
                  "type": "If",
                  "expression": {
                    "not": {
                      "contains": [
                        "@body('Inactive_ids')",
                        "@items('For_each_open_endorsement')?['Publication']?['Id']"
                      ]
                    }
                  },
                  "actions": {
                    "Due": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@if(and(not(empty(items('For_each_open_endorsement')?['ExtensionDate'])), greater(ticks(substring(coalesce(items('For_each_open_endorsement')?['ExtensionDate'], '0001-01-01'), 0, 10)), ticks(substring(items('For_each_open_endorsement')?['DueDate'], 0, 10)))), substring(coalesce(items('For_each_open_endorsement')?['ExtensionDate'], '0001-01-01'), 0, 10), substring(items('For_each_open_endorsement')?['DueDate'], 0, 10))"
                    },
                    "Days_past": {
                      "runAfter": {
                        "Due": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@div(sub(ticks(outputs('Today')), ticks(outputs('Due'))), 864000000000)"
                    },
                    "Reminder_date": {
                      "runAfter": {
                        "Days_past": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@addDays(outputs('Due'), mul(-1, add(mul(7, div(int(parameters('Reminder lead days (pfm_ReminderLeadDays)')), 5)), add(mod(int(parameters('Reminder lead days (pfm_ReminderLeadDays)')), 5), if(greaterOrEquals(mod(int(parameters('Reminder lead days (pfm_ReminderLeadDays)')), 5), dayOfWeek(outputs('Due'))), 2, 0)))), 'yyyy-MM-dd')"
                    },
                    "Escalation_date": {
                      "runAfter": {
                        "Reminder_date": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@addDays(outputs('Due'), add(mul(7, div(int(parameters('Escalation lag days (pfm_EscalationLagDays)')), 5)), add(mod(int(parameters('Escalation lag days (pfm_EscalationLagDays)')), 5), if(greater(add(dayOfWeek(outputs('Due')), mod(int(parameters('Escalation lag days (pfm_EscalationLagDays)')), 5)), 5), 2, 0))), 'yyyy-MM-dd')"
                    },
                    "Tier": {
                      "runAfter": {
                        "Escalation_date": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(greaterOrEquals(ticks(outputs('Today')), ticks(outputs('Escalation_date'))), 'Escalation', if(greaterOrEquals(ticks(outputs('Today')), ticks(outputs('Due'))), 'Warning', if(greaterOrEquals(ticks(outputs('Today')), ticks(outputs('Reminder_date'))), 'Reminder', 'None')))"
                    },
                    "If_tier_and_endorser_e-mail": {
                      "runAfter": {
                        "Tier": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "not": {
                              "equals": [
                                "@outputs('Tier')",
                                "None"
                              ]
                            }
                          },
                          {
                            "not": {
                              "equals": [
                                "@coalesce(items('For_each_open_endorsement')?['Endorser']?['Email'], '')",
                                ""
                              ]
                            }
                          }
                        ]
                      },
                      "actions": {
                        "Get_prior_reminder": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "GetItems"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                              "$filter": "@concat('Title eq ''', concat('Reminder Sent: E', string(items('For_each_open_endorsement')?['ID']), ' ', outputs('Tier'), ' ', outputs('Due'), if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), ' (test)', '')), '''')",
                              "$top": 1
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "If_not_yet_sent": {
                          "runAfter": {
                            "Get_prior_reminder": [
                              "Succeeded"
                            ]
                          },
                          "type": "If",
                          "expression": {
                            "equals": [
                              "@length(body('Get_prior_reminder')?['value'])",
                              0
                            ]
                          },
                          "actions": {
                            "Get_publication": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "GetItem"
                                },
                                "parameters": {
                                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                  "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                                  "id": "@items('For_each_open_endorsement')?['Publication']?['Id']"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            },
                            "Copy_to": {
                              "runAfter": {
                                "Filter_AO_emails": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(equals(outputs('Tier'), 'Escalation'), concat(join(body('Filter_AO_emails'), ';'), if(and(greater(length(body('Filter_AO_emails')), 0), not(empty(body('Get_publication')?['Requester']?['Email']))), ';', ''), coalesce(body('Get_publication')?['Requester']?['Email'], '')), '')"
                            },
                            "Log_reminder_sent": {
                              "runAfter": {
                                "If_shared_mailbox_reminder": [
                                  "Succeeded"
                                ]
                              },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PostItem"
                                },
                                "parameters": {
                                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                  "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                                  "item/Title": "@concat('Reminder Sent: E', string(items('For_each_open_endorsement')?['ID']), ' ', outputs('Tier'), ' ', outputs('Due'), if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), ' (test)', ''))",
                                  "item/Publication/Id": "@items('For_each_open_endorsement')?['Publication']?['Id']",
                                  "item/EventType/Value": "Reminder Sent",
                                  "item/EventDetails": "@concat(outputs('Tier'), ' e-mail sent for endorsement row ', string(items('For_each_open_endorsement')?['ID']), '; suspense ', outputs('Due'), if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), ' (test mode: sent to the PFM only)', ''))"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            },
                            "Select_AO_emails": {
                              "runAfter": {
                                "Get_publication": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Select",
                              "inputs": {
                                "from": "@coalesce(body('Get_publication')?['AO'], json('[]'))",
                                "select": "@item()?['Email']"
                              }
                            },
                            "Filter_AO_emails": {
                              "runAfter": {
                                "Select_AO_emails": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Query",
                              "inputs": {
                                "from": "@body('Select_AO_emails')",
                                "where": "@not(empty(item()))"
                              }
                            },
                            "Mail_to_reminder": {
                              "runAfter": {
                                "Copy_to": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), parameters('PFM e-mail (pfm_PfmEmail)'), items('For_each_open_endorsement')?['Endorser']?['Email'])"
                            },
                            "Mail_cc_reminder": {
                              "runAfter": {
                                "Mail_to_reminder": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), '', outputs('Copy_to'))"
                            },
                            "Mail_note_reminder": {
                              "runAfter": {
                                "Mail_cc_reminder": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), concat('<p><b>TEST MODE</b>: this e-mail went to the PFM only. Intended To: ', items('For_each_open_endorsement')?['Endorser']?['Email'], '; Cc: ', outputs('Copy_to'), '.</p>'), '')"
                            },
                            "If_shared_mailbox_reminder": {
                              "runAfter": {
                                "Mail_note_reminder": [
                                  "Succeeded"
                                ]
                              },
                              "type": "If",
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@empty(parameters('Shared mailbox (pfm_SharedMailbox)'))",
                                      true
                                    ]
                                  }
                                ]
                              },
                              "actions": {
                                "Send_from_the_owner_reminder": {
                                  "runAfter": {},
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                      "connectionName": "shared_office365",
                                      "operationId": "SendEmailV2"
                                    },
                                    "authentication": "@parameters('$authentication')",
                                    "parameters": {
                                      "emailMessage/To": "@outputs('Mail_to_reminder')",
                                      "emailMessage/Cc": "@outputs('Mail_cc_reminder')",
                                      "emailMessage/Subject": "@concat(if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), 'TEST: ', ''), concat(outputs('Tier'), ': coordination response due ', outputs('Due'), ' - ', coalesce(items('For_each_open_endorsement')?['Title'], '')))",
                                      "emailMessage/Body": "@concat(outputs('Mail_note_reminder'), concat('<p>Coordination of ', coalesce(items('For_each_open_endorsement')?['Title'], 'a publication action'), ' is waiting for your response (DAFMAN 90-161, 5.2).</p>', '<p>Your suspense is ', outputs('Due'), if(equals(outputs('Tier'), 'Reminder'), '. This is an advance reminder.', if(equals(outputs('Tier'), 'Warning'), '. The suspense is today or has passed.', concat('. The suspense passed ', string(outputs('Days_past')), ' days ago.'))), '</p>', '<p>Please respond with Concur, Concur With Comment, Nonconcur or No Comment, or ask for an extension before the suspense with your rationale and estimated completion date (5.2.1).</p>', if(equals(outputs('Tier'), 'Escalation'), if(or(equals(items('For_each_open_endorsement')?['CoordinationRole']?['Value'], 'Legal'), equals(items('For_each_open_endorsement')?['CoordinationStage']?['Value'], 'Legal')), '<p>The action officer and requester are copied. Legal coordination cannot be closed as Concur - No Response (5.4.3).</p>', '<p>The action officer and requester are copied. The action officer may record Concur - No Response with an explanation in the staff package (5.4.3.2).</p>'), ''), '<p>This message is sent by the 90-161.Z publications flow.</p>'))",
                                      "emailMessage/Importance": "@if(equals(outputs('Tier'), 'Escalation'), 'High', 'Normal')"
                                    }
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Send_from_the_shared_mailbox_reminder": {
                                    "runAfter": {},
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                        "connectionName": "shared_office365",
                                        "operationId": "SharedMailboxSendEmailV2"
                                      },
                                      "authentication": "@parameters('$authentication')",
                                      "parameters": {
                                        "emailMessage/MailboxAddress": "@parameters('Shared mailbox (pfm_SharedMailbox)')",
                                        "emailMessage/To": "@outputs('Mail_to_reminder')",
                                        "emailMessage/Cc": "@outputs('Mail_cc_reminder')",
                                        "emailMessage/Subject": "@concat(if(equals(toLower(trim(parameters('Test mode (pfm_TestMode)'))), 'yes'), 'TEST: ', ''), concat(outputs('Tier'), ': coordination response due ', outputs('Due'), ' - ', coalesce(items('For_each_open_endorsement')?['Title'], '')))",
                                        "emailMessage/Body": "@concat(outputs('Mail_note_reminder'), concat('<p>Coordination of ', coalesce(items('For_each_open_endorsement')?['Title'], 'a publication action'), ' is waiting for your response (DAFMAN 90-161, 5.2).</p>', '<p>Your suspense is ', outputs('Due'), if(equals(outputs('Tier'), 'Reminder'), '. This is an advance reminder.', if(equals(outputs('Tier'), 'Warning'), '. The suspense is today or has passed.', concat('. The suspense passed ', string(outputs('Days_past')), ' days ago.'))), '</p>', '<p>Please respond with Concur, Concur With Comment, Nonconcur or No Comment, or ask for an extension before the suspense with your rationale and estimated completion date (5.2.1).</p>', if(equals(outputs('Tier'), 'Escalation'), if(or(equals(items('For_each_open_endorsement')?['CoordinationRole']?['Value'], 'Legal'), equals(items('For_each_open_endorsement')?['CoordinationStage']?['Value'], 'Legal')), '<p>The action officer and requester are copied. Legal coordination cannot be closed as Concur - No Response (5.4.3).</p>', '<p>The action officer and requester are copied. The action officer may record Concur - No Response with an explanation in the staff package (5.4.3.2).</p>'), ''), '<p>This message is sent by the 90-161.Z publications flow.</p>'))",
                                        "emailMessage/Importance": "@if(equals(outputs('Tier'), 'Escalation'), 'High', 'Normal')"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          }
        },
        "Catch": {
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Scope",
          "actions": {
            "Failed_steps": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@result('Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Failed_text": {
              "runAfter": {
                "Failed_steps": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Failed_steps')",
                "select": "@concat('<li>', item()?['name'], ': ', take(coalesce(item()?['error']?['message'], string(item()?['outputs']), 'no message'), 600), '</li>')"
              }
            },
            "Send_failure_e-mail": {
              "runAfter": {
                "Failed_text": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')",
                "parameters": {
                  "emailMessage/To": "@parameters('PFM e-mail (pfm_PfmEmail)')",
                  "emailMessage/Subject": "@concat('90161Z flow failed: F03 Suspense Reminders r3', '')",
                  "emailMessage/Body": "@concat('<p>The flow F03 Suspense Reminders r3 stopped on a failed step.</p><p>Run: ', workflow()?['run']?['name'], '</p><ul>', join(body('Failed_text'), ''), '</ul><p>Fix the cause, then open the run in the run history and select Resubmit. A resubmitted run does not repeat what the failed run already did.</p>')",
                  "emailMessage/Importance": "High"
                }
              }
            },
            "End_as_failed": {
              "runAfter": {
                "Send_failure_e-mail": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "StepFailed",
                  "message": "A step failed; the PFM was e-mailed."
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
