          "item/ProbeDetail": "@if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), 'shared mailbox value empty', concat('sent=', actions('S2')?['status'], '; status=', if(equals(actions('S2')?['outputs']?['statusCode'], null), 'none', string(actions('S2')?['outputs']?['statusCode']))))"
        },
