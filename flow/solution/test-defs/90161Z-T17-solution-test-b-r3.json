{
  "displayName": "90161Z T17 Solution Import Test B r3",
  "description": "R17 test B r3 (PFM 14 Nov 26): the same flow with the Site URL environment variable; its definition file has no XML declaration (the suspected cause of the R15 and R16 XML node error). Reads the row count of PFM Settings and writes one result file 90161Z-T17-solution-result-b-r3.txt to the site's default document library. Changes nothing else.",
  "connections": [
    "shared_sharepointonline"
  ],
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    }
  },
  "actions": {
    "Read_settings_count": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFM Settings')?$select=ItemCount",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          }
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Write_result_file": {
      "runAfter": {
        "Read_settings_count": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/DefaultDocumentLibrary/RootFolder/Files/add(url='90161Z-T17-solution-result-b-r3.txt',overwrite=true)",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          },
          "parameters/body": "@{concat('SOLUTION B import=OK connection-reference=OK environment-variable=OK settings-read-status=', string(outputs('Read_settings_count')?['statusCode']), ' settings-rows=', string(coalesce(body('Read_settings_count')?['ItemCount'], 'none')), ' run-utc=', utcNow())}"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "variant": "B"
}
