{
  "displayName": "90161Z F05 Endorsement Routing r2",
  "description": "When a PFM Publications row is at process step 6 (Formal coordination) and its Action Status is not On Hold, Cancelled or Complete: adds a Formal Coordination row for each active mandatory office that has none; when every other coordinator has answered and all comments are adjudicated, adds the missing Legal rows and moves the step to 7. At step 7 it adds missing Legal rows. Stops when Flows paused is Yes; e-mails the alert address when a step fails. DAFMAN 90-161 3.4, 5.1, 5.1.8.2; PFM S5A and 14 Nov 26.",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Try": {
      "runAfter": {},
      "type": "Scope",
      "actions": {
        "If_flows_paused": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "equals": [
              "@toLower(trim(coalesce(parameters('Flows paused (pfm_FlowsPaused)'), '')))",
              "yes"
            ]
          },
          "actions": {
            "Stop_flows_are_paused": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Test_hook_forced_failure": {
          "runAfter": {
            "If_flows_paused": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@toLower(trim(coalesce(parameters('Test mode (pfm_TestMode)'), '')))",
                  "yes"
                ]
              },
              {
                "equals": [
                  "@startsWith(coalesce(triggerBody()?['Title'], ''), '90161Z TEST FAIL')",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Read_the_row_now": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                  "id": "@triggerBody()?['ID']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_still_marked_to_fail": {
              "runAfter": {
                "Read_the_row_now": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@startsWith(coalesce(body('Read_the_row_now')?['Title'], ''), '90161Z TEST FAIL')",
                  true
                ]
              },
              "actions": {
                "Forced_failure_for_the_test": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@int('forced failure: test mode and a 90161Z TEST FAIL title')"
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "If_action_open": {
          "runAfter": {
            "Test_hook_forced_failure": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@coalesce(string(triggerBody()?['ProcessStep']?['Id']), '')",
                    ""
                  ]
                }
              },
              {
                "equals": [
                  "@contains(createArray('On Hold', 'Cancelled', 'Complete'), coalesce(triggerBody()?['ActionStatus']?['Value'], ''))",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Get_process_step": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
                  "id": "@triggerBody()?['ProcessStep']?['Id']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_endorsement_rows": {
              "runAfter": {
                "Get_process_step": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                  "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']))",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Formal_rows": {
              "runAfter": {
                "Get_endorsement_rows": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_endorsement_rows')?['value']",
                "where": "@equals(item()?['CoordinationStage']?['Value'], 'Formal Coordination')"
              }
            },
            "Legal_rows": {
              "runAfter": {
                "Formal_rows": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_endorsement_rows')?['value']",
                "where": "@equals(item()?['CoordinationStage']?['Value'], 'Legal')"
              }
            },
            "Pending_rows": {
              "runAfter": {
                "Legal_rows": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Formal_rows')",
                "where": "@and(equals(item()?['EndorsementStatus']?['Value'], 'Not Started'), not(equals(item()?['CoordinationRole']?['Value'], 'Legal')))"
              }
            },
            "Formal_titles": {
              "runAfter": {
                "Pending_rows": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Formal_rows')",
                "select": "@coalesce(item()?['Title'], '')"
              }
            },
            "Legal_titles": {
              "runAfter": {
                "Formal_titles": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Legal_rows')",
                "select": "@coalesce(item()?['Title'], '')"
              }
            },
            "Formal_title_list": {
              "runAfter": {
                "Legal_titles": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@concat('|', join(body('Formal_titles'), '|'), '|')"
            },
            "Legal_title_list": {
              "runAfter": {
                "Formal_title_list": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@concat('|', join(body('Legal_titles'), '|'), '|')"
            },
            "If_step_6": {
              "runAfter": {
                "Legal_title_list": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@body('Get_process_step')?['StepNumber']",
                  6
                ]
              },
              "actions": {
                "Get_mandatory_offices": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                      "$filter": "MandatoryCoordinator eq 1 and IsActive eq 1 and CoordinateLast eq 0",
                      "$top": 500
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Missing_formal_offices": {
                  "runAfter": {
                    "Get_mandatory_offices": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Get_mandatory_offices')?['value']",
                    "where": "@not(contains(outputs('Formal_title_list'), concat(' - ', coalesce(item()?['Title'], ''), '|')))"
                  }
                },
                "Create_formal_rows": {
                  "runAfter": {
                    "Missing_formal_offices": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach",
                  "foreach": "@body('Missing_formal_offices')",
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "If_office_has_endorser_Formal": {
                      "runAfter": {},
                      "type": "If",
                      "expression": {
                        "not": {
                          "equals": [
                            "@coalesce(items('Create_formal_rows')?['Endorser']?['Claims'], '')",
                            ""
                          ]
                        }
                      },
                      "actions": {
                        "Create_row_with_endorser_Formal": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                              "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                              "item/Publication/Id": "@triggerBody()?['ID']",
                              "item/CoordinationStage/Value": "Formal Coordination",
                              "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                              "item/IsRequired": true,
                              "item/EndorsementStatus/Value": "Not Started",
                              "item/Endorser/Claims": "@items('Create_formal_rows')?['Endorser']?['Claims']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_row_without_endorser_Formal": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PostItem"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                                "item/Publication/Id": "@triggerBody()?['ID']",
                                "item/CoordinationStage/Value": "Formal Coordination",
                                "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                                "item/IsRequired": true,
                                "item/EndorsementStatus/Value": "Not Started"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "If_formal_rows_added": {
                  "runAfter": {
                    "Create_formal_rows": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "greater": [
                      "@length(body('Missing_formal_offices'))",
                      0
                    ]
                  },
                  "actions": {
                    "Log_formal_rows": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                          "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                          "item/Publication/Id": "@triggerBody()?['ID']",
                          "item/EventType/Value": "Endorsement Requested",
                          "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                          "item/EventDetails": "@concat('Formal Coordination rows added for offices that had none (mandatory, active, not Legal): ', string(length(body('Missing_formal_offices'))), '. DAFMAN 90-161 3.4, 5.1.')"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "If_ready_for_Legal": {
                        "runAfter": {},
                        "type": "If",
                        "expression": {
                          "and": [
                            {
                              "greater": [
                                "@length(body('Formal_rows'))",
                                0
                              ]
                            },
                            {
                              "equals": [
                                "@length(body('Pending_rows'))",
                                0
                              ]
                            },
                            {
                              "equals": [
                                "@coalesce(triggerBody()?['AllCommentsAdjudicated'], false)",
                                true
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "Get_legal_offices": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "GetItems"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                                "$filter": "CoordinateLast eq 1 and IsActive eq 1",
                                "$top": 500
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Missing_legal_offices": {
                            "runAfter": {
                              "Get_legal_offices": [
                                "Succeeded"
                              ]
                            },
                            "type": "Query",
                            "inputs": {
                              "from": "@body('Get_legal_offices')?['value']",
                              "where": "@not(contains(outputs('Legal_title_list'), concat(' - ', coalesce(item()?['Title'], ''), '|')))"
                            }
                          },
                          "Create_legal_rows": {
                            "runAfter": {
                              "Missing_legal_offices": [
                                "Succeeded"
                              ]
                            },
                            "type": "Foreach",
                            "foreach": "@body('Missing_legal_offices')",
                            "runtimeConfiguration": {
                              "concurrency": {
                                "repetitions": 1
                              }
                            },
                            "actions": {
                              "If_office_has_endorser_Legal": {
                                "runAfter": {},
                                "type": "If",
                                "expression": {
                                  "not": {
                                    "equals": [
                                      "@coalesce(items('Create_legal_rows')?['Endorser']?['Claims'], '')",
                                      ""
                                    ]
                                  }
                                },
                                "actions": {
                                  "Create_row_with_endorser_Legal": {
                                    "runAfter": {},
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                        "connectionName": "shared_sharepointonline",
                                        "operationId": "PostItem"
                                      },
                                      "parameters": {
                                        "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                        "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                        "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                        "item/Publication/Id": "@triggerBody()?['ID']",
                                        "item/CoordinationStage/Value": "Legal",
                                        "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                        "item/IsRequired": true,
                                        "item/EndorsementStatus/Value": "Not Started",
                                        "item/Endorser/Claims": "@items('Create_legal_rows')?['Endorser']?['Claims']"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {
                                    "Create_row_without_endorser_Legal": {
                                      "runAfter": {},
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "host": {
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                          "connectionName": "shared_sharepointonline",
                                          "operationId": "PostItem"
                                        },
                                        "parameters": {
                                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                          "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                          "item/Publication/Id": "@triggerBody()?['ID']",
                                          "item/CoordinationStage/Value": "Legal",
                                          "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                          "item/IsRequired": true,
                                          "item/EndorsementStatus/Value": "Not Started"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "Get_legal_step": {
                            "runAfter": {
                              "Create_legal_rows": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "GetItems"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
                                "$filter": "StepNumber eq 7",
                                "$top": 1
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Move_to_legal_step": {
                            "runAfter": {
                              "Get_legal_step": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PatchItem"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                                "id": "@triggerBody()?['ID']",
                                "item/Title": "@triggerBody()?['Title']",
                                "item/ProcessStep/Id": "@first(body('Get_legal_step')?['value'])?['ID']"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Log_legal_rows": {
                            "runAfter": {
                              "Move_to_legal_step": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PostItem"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                                "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                                "item/Publication/Id": "@triggerBody()?['ID']",
                                "item/EventType/Value": "Endorsement Requested",
                                "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                                "item/EventDetails": "@concat('Legal rows added for offices that had none: ', string(length(body('Missing_legal_offices'))), '; moved to step 7 (Legal coordination). DAFMAN 90-161 5.1.8.2.')"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "If_step_7": {
              "runAfter": {
                "If_step_6": [
                  "Succeeded",
                  "Skipped"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@body('Get_process_step')?['StepNumber']",
                  7
                ]
              },
              "actions": {
                "Get_legal_offices_at_step_7": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                      "$filter": "CoordinateLast eq 1 and IsActive eq 1",
                      "$top": 500
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Missing_legal_offices_at_step_7": {
                  "runAfter": {
                    "Get_legal_offices_at_step_7": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Get_legal_offices_at_step_7')?['value']",
                    "where": "@not(contains(outputs('Legal_title_list'), concat(' - ', coalesce(item()?['Title'], ''), '|')))"
                  }
                },
                "Create_legal_rows_at_step_7": {
                  "runAfter": {
                    "Missing_legal_offices_at_step_7": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach",
                  "foreach": "@body('Missing_legal_offices_at_step_7')",
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "If_office_has_endorser_Legal_7": {
                      "runAfter": {},
                      "type": "If",
                      "expression": {
                        "not": {
                          "equals": [
                            "@coalesce(items('Create_legal_rows_at_step_7')?['Endorser']?['Claims'], '')",
                            ""
                          ]
                        }
                      },
                      "actions": {
                        "Create_row_with_endorser_Legal_7": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                              "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows_at_step_7')?['Title'], '')), 250)",
                              "item/Publication/Id": "@triggerBody()?['ID']",
                              "item/CoordinationStage/Value": "Legal",
                              "item/CoordinationRole/Value": "@items('Create_legal_rows_at_step_7')?['CoordinationRole']?['Value']",
                              "item/IsRequired": true,
                              "item/EndorsementStatus/Value": "Not Started",
                              "item/Endorser/Claims": "@items('Create_legal_rows_at_step_7')?['Endorser']?['Claims']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_row_without_endorser_Legal_7": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PostItem"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows_at_step_7')?['Title'], '')), 250)",
                                "item/Publication/Id": "@triggerBody()?['ID']",
                                "item/CoordinationStage/Value": "Legal",
                                "item/CoordinationRole/Value": "@items('Create_legal_rows_at_step_7')?['CoordinationRole']?['Value']",
                                "item/IsRequired": true,
                                "item/EndorsementStatus/Value": "Not Started"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "If_legal_rows_added_at_step_7": {
                  "runAfter": {
                    "Create_legal_rows_at_step_7": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "greater": [
                      "@length(body('Missing_legal_offices_at_step_7'))",
                      0
                    ]
                  },
                  "actions": {
                    "Log_legal_rows_at_step_7": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                          "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                          "item/Publication/Id": "@triggerBody()?['ID']",
                          "item/EventType/Value": "Endorsement Requested",
                          "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                          "item/EventDetails": "@concat('Legal rows added at step 7 for offices that had none: ', string(length(body('Missing_legal_offices_at_step_7'))), '. DAFMAN 90-161 5.1.8.2.')"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "Failed_actions": {
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "Query",
      "inputs": {
        "from": "@result('Try')",
        "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
      }
    },
    "Failure_lines": {
      "runAfter": {
        "Failed_actions": [
          "Succeeded"
        ]
      },
      "type": "Select",
      "inputs": {
        "from": "@body('Failed_actions')",
        "select": "@concat('<li><b>', replace(coalesce(item()?['name'], 'step'), '_', ' '), '</b>: ', coalesce(item()?['error']?['message'], item()?['error']?['code'], 'no error text'), '</li>')"
      }
    },
    "E-mail_the_failure": {
      "runAfter": {
        "Failure_lines": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "authentication": "@parameters('$authentication')",
        "parameters": {
          "emailMessage/To": "@parameters('Alert e-mail (pfm_AlertEmail)')",
          "emailMessage/Subject": "@concat('90-161.Z flow failed: F05 ', coalesce(workflow()?['tags']?['flowDisplayName'], ''))",
          "emailMessage/Body": "@concat('<p>A 90-161.Z flow stopped with an error. Nothing after the failed step ran.</p>', '<p><b>Flow:</b> ', coalesce(workflow()?['tags']?['flowDisplayName'], 'F05'), '<br><b>Started:</b> ', convertTimeZone(utcNow(), 'UTC', 'Central Standard Time', 'dd MMM yy HHmm'), ' Central', '<br><b>Publication row:</b> ', string(triggerBody()?['ID']), '</p>', '<p><b>Failed step:</b></p><ul>', join(body('Failure_lines'), ''), '</ul>', '<p><b>What to do:</b> 1. In Power Automate, open this flow and its 28-day run history; the failed run has the start time above. 2. Fix the cause the step names (for example a list name or a connection). 3. Select Resubmit on that run: the flow starts again from the beginning and adds only what is missing.</p>', '<p>This message is sent by the 90-161.Z publications flow.</p>')",
          "emailMessage/Importance": "High"
        }
      }
    }
  }
}
