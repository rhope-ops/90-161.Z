          "Skipped",
          "TimedOut"
        ]
      },
      "type": "Compose",
      "inputs": "@concat(if(contains(string(actions('READ1_inbox')?['outputs']?['body']), 'T9 S3 '), '+inbox', ''), if(contains(string(actions('READ1_junk')?['outputs']?['body']), 'T9 S3 '), '+junk', ''), if(contains(string(actions('READ1_sent')?['outputs']?['body']), 'T9 S3 '), '+sent', ''), if(contains(if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), '', string(actions('READ1_box')?['outputs']?['body'])), 'T9 S3 '), '+boxsent', ''))"
    },
    "READ1_where_S5": {
      "runAfter": {
        "READ1_inbox": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "READ1_junk": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "READ1_sent": [
          "Succeeded",
