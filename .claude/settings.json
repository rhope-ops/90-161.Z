{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(scripts/check.sh*)",
      "Bash(bash scripts/check.sh*)",
      "Bash(bash scripts/session_checkin.sh*)",
      "Bash(python3 scripts/check_content.py*)",
      "Bash(python3 scripts/bloat_check.py*)",
      "Bash(python3 scripts/drift.py*)",
      "Bash(python3 scripts/log_check.py*)"
    ],
    "ask": [
      "Bash(*--output*)",
      "Bash(*--record*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(*--no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git * push*--force*)",
      "Bash(git * push* -f*)",
      "Bash(git -* reset --hard*)",
      "Bash(git -* clean*)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D*)",
      "Bash(git *hookspath*)",
      "Bash(git *HOOKSPATH*)",
      "Bash(git * stash*)",
      "Bash(git * restore *)",
      "Bash(git * branch -D*)",
      "Bash(git * checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git * checkout .*)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git *--discard-changes*)",
      "Bash(git *branch --delete --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|NotebookEdit|SendMessage|Agent|Task|Artifact|ArtifactData|ArtifactComments|SendUserFile|WebFetch|WebSearch|mcp__github__.*(pull_request|issue|comment|review|create_or_update_file|push_files).*|mcp__Gmail__(send_message|reply|forward|create_draft|update_draft)|mcp__Claude_Docs__(batch|update|create)|mcp__Google_(Docs|Drive|Sheets)__.*|mcp__Google_Calendar__(create_event|update_event|respond_to_event)|mcp__ccd_session__spawn_task|mcp__claude-code-remote__(send_message|create_session|create_trigger|update_trigger|send_later|create_environment|update_environment))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/check.sh --hook || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/stop_check.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/first_use_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    },
    "excludedCommands": [
      "scripts/session_checkin.sh",
      "bash scripts/session_checkin.sh"
    ]
  }
}
