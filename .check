# Settings of the content check (scripts/check.sh --content; the pre-push hook and the "checks" GitHub Action).
# One entry per line:
#   <exact string>          allowed although it looks like personal data
#   skip: <path or glob>    not scanned
#   block: <path or glob>   must not be committed or sent (for example `block: *.xlsx`)
#   profile: dod            the DoD tier; `denylist: warn` lets a push pass with no name denylist
#   content-max-bytes: <n>  scan text files up to n bytes (default 2000000, at most 50000000; larger ones block in the DoD tier)
#   code-<key>: <value>     a setting of the code standard, for example `code-max-function-lines: 60`
#   audit-<key>: <value>    a setting of the audit, for example `audit-ignore: ref/**`
#                           (the keys and their defaults: the header of scripts/check_settings.py; a `code-` change
#                           needs a docs/DECISIONS.md row that names this file)
# An allowed string or a skip line is added only on the PFM's request, never by an agent to get past a block (AGENTS.md "Guards and checks").
# Public DAF manual text: office mailboxes, phone numbers and .mil sites printed in DAFMAN 90-161 (PFM, 2026-11-11).
skip: ref/dafman90-161.txt
skip: docs/dafman-coverage/*
skip: docs/coordination-table-a3-2.md
# Public host names (PFM, 2026-11-11).
GenAI.mil
usaf.dps.mil
# Public host names for go.md Task 12 (PFM 2A, 2026-11-12).
www.ang.af.mil
www.dafhistory.af.mil
www.trademark.af.mil
# Public suffix of a classified network, in the RADE NIPR check inside the round bundles (PFM, 2026-11-14).
smil.mil
# Escaped form of the same public host, in tests/run.sh (PFM, 2026-11-11).
usaf\.dps\.mil
# DoD tier (PFM, 2026-11-15): military and DoD cloud hosts, marks, DoD ID numbers, unreadable files.
profile: dod
# The CUI access-marking choice and its description in schemas/lists and the generated payload (PFM, 2026-11-15).
Controlled Unclassified Information
"CUI"
"CUI",
# Example host in the Site URL prompt of scripts/gov/Provision-Lists.ps1 (PFM, 2026-11-15).
sharepoint-mil.us
# Binary files the guard cannot read: public references, generated packages, briefs, samples (PFM, 2026-11-15).
skip: docs/brief/*.pptx
skip: flow/packages/*.zip
skip: flow/solution/*.zip
skip: ref/*.pdf
skip: samples/*.png
skip: samples/*.docx
skip: templates/*.docx
# Real-window spike pictures in a session scratchpad, invented data only (PFM, 2026-11-17).
skip: /tmp/claude-0/*/scratchpad/spike/*.png
# Code standard and audit settings (the keys: the header of scripts/check_settings.py).
code-max-line-chars: 200
code-generated: scripts/gov/paste/*.ps1
code-c1-safety: on
code-c2: full
audit-ignore: ref/**
audit-ignore: scripts/gov/paste/**
audit-ignore: flow/provisioning-payload.json
audit-ignore: flow/packages/**
audit-ignore: tests/fixtures/*.publication.json
