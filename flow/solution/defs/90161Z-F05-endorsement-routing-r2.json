{
  "displayName": "90161Z F05 Endorsement Routing r2",
  "description": "When a PFM Publications row is at process step 6 (Formal coordination): adds the missing Formal Coordination rows from PFM Offices for the current coordination round; when every other coordinator has answered and all comments are adjudicated, creates the Legal rows and moves the step to 7 (Legal coordination). Skips actions On Hold, Cancelled or Complete; a failed step e-mails the PFM. DAFMAN 90-161 3.4, 5.1, 5.1.8.2; PFM S5A, 2026-11-14.",
  "workflowKey": "90161Z-F05-endorsement-routing-r1",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "If_flows_on": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@equals(toLower(trim(parameters('Flows off (pfm_FlowsOff)'))), 'yes')",
            true
          ]
        }
      },
      "actions": {
        "Try": {
          "runAfter": {},
          "type": "Scope",
          "actions": {
            "If_active_at_a_step": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "contains": [
                        "@createArray('On Hold', 'Cancelled', 'Complete')",
                        "@coalesce(triggerBody()?['ActionStatus']?['Value'], '')"
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@coalesce(string(triggerBody()?['ProcessStep']?['Id']), '')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_process_step": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
                      "id": "@triggerBody()?['ProcessStep']?['Id']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "If_formal_coordination": {
                  "runAfter": {
                    "Get_process_step": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@int(body('Get_process_step')?['StepNumber'])",
                      6
                    ]
                  },
                  "actions": {
                    "Get_formal_rows": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                          "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and CoordinationStage eq ''Formal Coordination''')",
                          "$top": 500
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Get_legal_rows": {
                      "runAfter": {
                        "Get_formal_rows": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                          "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and CoordinationStage eq ''Legal''')",
                          "$top": 500
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Formal_rounds": {
                      "runAfter": {
                        "Get_legal_rows": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Get_formal_rows')?['value']",
                        "select": "@coalesce(item()?['CoordinationRound'], 1)"
                      }
                    },
                    "Round": {
                      "runAfter": {
                        "Formal_rounds": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(equals(length(body('Formal_rounds')), 0), 1, max(body('Formal_rounds')))"
                    },
                    "Current_formal": {
                      "runAfter": {
                        "Round": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Get_formal_rows')?['value']",
                        "where": "@greaterOrEquals(coalesce(item()?['CoordinationRound'], 1), outputs('Round'))"
                      }
                    },
                    "Current_legal": {
                      "runAfter": {
                        "Current_formal": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Get_legal_rows')?['value']",
                        "where": "@greaterOrEquals(coalesce(item()?['CoordinationRound'], 1), outputs('Round'))"
                      }
                    },
                    "Pending_rows": {
                      "runAfter": {
                        "Current_legal": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Current_formal')",
                        "where": "@and(equals(item()?['EndorsementStatus']?['Value'], 'Not Started'), not(equals(item()?['CoordinationRole']?['Value'], 'Legal')))"
                      }
                    },
                    "Formal_offices": {
                      "runAfter": {
                        "Pending_rows": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Current_formal')",
                        "select": "@last(split(coalesce(item()?['Title'], ''), ' - '))"
                      }
                    },
                    "Get_mandatory_offices": {
                      "runAfter": {
                        "Formal_offices": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "parameters": {
                          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                          "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                          "$filter": "MandatoryCoordinator eq 1 and IsActive eq 1 and CoordinateLast eq 0",
                          "$top": 500
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Missing_offices": {
                      "runAfter": {
                        "Get_mandatory_offices": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Get_mandatory_offices')?['value']",
                        "where": "@not(contains(body('Formal_offices'), coalesce(item()?['Title'], '')))"
                      }
                    },
                    "If_rows_missing": {
                      "runAfter": {
                        "Missing_offices": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "greater": [
                          "@length(body('Missing_offices'))",
                          0
                        ]
                      },
                      "actions": {
                        "Create_formal_rows": {
                          "runAfter": {},
                          "type": "Foreach",
                          "foreach": "@body('Missing_offices')",
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "actions": {
                            "If_office_has_endorser_Formal": {
                              "runAfter": {},
                              "type": "If",
                              "expression": {
                                "not": {
                                  "equals": [
                                    "@coalesce(items('Create_formal_rows')?['Endorser']?['Claims'], '')",
                                    ""
                                  ]
                                }
                              },
                              "actions": {
                                "Create_row_with_endorser_Formal": {
                                  "runAfter": {},
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "PostItem"
                                    },
                                    "parameters": {
                                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                      "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                      "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                                      "item/Publication/Id": "@triggerBody()?['ID']",
                                      "item/CoordinationStage/Value": "Formal Coordination",
                                      "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                                      "item/IsRequired": true,
                                      "item/EndorsementStatus/Value": "Not Started",
                                      "item/Endorser/Claims": "@items('Create_formal_rows')?['Endorser']?['Claims']",
                                      "item/CoordinationRound": "@outputs('Round')"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Create_row_without_endorser_Formal": {
                                    "runAfter": {},
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                        "connectionName": "shared_sharepointonline",
                                        "operationId": "PostItem"
                                      },
                                      "parameters": {
                                        "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                        "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                        "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                                        "item/Publication/Id": "@triggerBody()?['ID']",
                                        "item/CoordinationStage/Value": "Formal Coordination",
                                        "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                                        "item/IsRequired": true,
                                        "item/EndorsementStatus/Value": "Not Started",
                                        "item/CoordinationRound": "@outputs('Round')"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "Log_formal_rows": {
                          "runAfter": {
                            "Create_formal_rows": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                              "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                              "item/Publication/Id": "@triggerBody()?['ID']",
                              "item/EventType/Value": "Endorsement Requested",
                              "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                              "item/EventDetails": "@concat('Formal Coordination rows created from PFM Offices (mandatory, active, not Legal): ', string(length(body('Missing_offices'))), if(greater(length(body('Current_formal')), 0), concat(' missing row(s) added; ', string(length(body('Current_formal'))), ' already there'), ''), '. Coordination round ', string(outputs('Round')), '. DAFMAN 90-161 3.4, 5.1.')"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "If_ready_for_Legal": {
                            "runAfter": {},
                            "type": "If",
                            "expression": {
                              "and": [
                                {
                                  "greater": [
                                    "@length(body('Current_formal'))",
                                    0
                                  ]
                                },
                                {
                                  "equals": [
                                    "@length(body('Current_legal'))",
                                    0
                                  ]
                                },
                                {
                                  "equals": [
                                    "@length(body('Pending_rows'))",
                                    0
                                  ]
                                },
                                {
                                  "equals": [
                                    "@coalesce(triggerBody()?['AllCommentsAdjudicated'], false)",
                                    true
                                  ]
                                }
                              ]
                            },
                            "actions": {
                              "Get_legal_offices": {
                                "runAfter": {},
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "GetItems"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                    "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                                    "$filter": "CoordinateLast eq 1 and IsActive eq 1",
                                    "$top": 500
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              },
                              "Create_legal_rows": {
                                "runAfter": {
                                  "Get_legal_offices": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "Foreach",
                                "foreach": "@body('Get_legal_offices')?['value']",
                                "runtimeConfiguration": {
                                  "concurrency": {
                                    "repetitions": 1
                                  }
                                },
                                "actions": {
                                  "If_office_has_endorser_Legal": {
                                    "runAfter": {},
                                    "type": "If",
                                    "expression": {
                                      "not": {
                                        "equals": [
                                          "@coalesce(items('Create_legal_rows')?['Endorser']?['Claims'], '')",
                                          ""
                                        ]
                                      }
                                    },
                                    "actions": {
                                      "Create_row_with_endorser_Legal": {
                                        "runAfter": {},
                                        "type": "OpenApiConnection",
                                        "inputs": {
                                          "host": {
                                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                            "connectionName": "shared_sharepointonline",
                                            "operationId": "PostItem"
                                          },
                                          "parameters": {
                                            "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                            "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                            "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                            "item/Publication/Id": "@triggerBody()?['ID']",
                                            "item/CoordinationStage/Value": "Legal",
                                            "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                            "item/IsRequired": true,
                                            "item/EndorsementStatus/Value": "Not Started",
                                            "item/Endorser/Claims": "@items('Create_legal_rows')?['Endorser']?['Claims']",
                                            "item/CoordinationRound": "@outputs('Round')"
                                          },
                                          "authentication": "@parameters('$authentication')"
                                        }
                                      }
                                    },
                                    "else": {
                                      "actions": {
                                        "Create_row_without_endorser_Legal": {
                                          "runAfter": {},
                                          "type": "OpenApiConnection",
                                          "inputs": {
                                            "host": {
                                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                              "connectionName": "shared_sharepointonline",
                                              "operationId": "PostItem"
                                            },
                                            "parameters": {
                                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                              "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                              "item/Publication/Id": "@triggerBody()?['ID']",
                                              "item/CoordinationStage/Value": "Legal",
                                              "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                              "item/IsRequired": true,
                                              "item/EndorsementStatus/Value": "Not Started",
                                              "item/CoordinationRound": "@outputs('Round')"
                                            },
                                            "authentication": "@parameters('$authentication')"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "Get_legal_step": {
                                "runAfter": {
                                  "Create_legal_rows": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "GetItems"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                    "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
                                    "$filter": "StepNumber eq 7",
                                    "$top": 1
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              },
                              "Move_to_legal_step": {
                                "runAfter": {
                                  "Get_legal_step": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PatchItem"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                    "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                                    "id": "@triggerBody()?['ID']",
                                    "item/Title": "@triggerBody()?['Title']",
                                    "item/ProcessStep/Id": "@first(body('Get_legal_step')?['value'])?['ID']"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              },
                              "Log_legal_rows": {
                                "runAfter": {
                                  "Move_to_legal_step": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PostItem"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                    "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                                    "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                                    "item/Publication/Id": "@triggerBody()?['ID']",
                                    "item/EventType/Value": "Endorsement Requested",
                                    "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                                    "item/EventDetails": "@concat('All other coordinators answered and comments adjudicated; Legal rows created: ', string(length(body('Get_legal_offices')?['value'])), '; step moved to Legal coordination. Coordination round ', string(outputs('Round')), '. DAFMAN 90-161 5.1.8.2.')"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              }
                            },
                            "else": {
                              "actions": {}
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        },
        "Catch": {
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Scope",
          "actions": {
            "Failed_steps": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@result('Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Failed_text": {
              "runAfter": {
                "Failed_steps": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Failed_steps')",
                "select": "@concat('<li>', item()?['name'], ': ', take(coalesce(item()?['error']?['message'], string(item()?['outputs']), 'no message'), 600), '</li>')"
              }
            },
            "Send_failure_e-mail": {
              "runAfter": {
                "Failed_text": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "authentication": "@parameters('$authentication')",
                "parameters": {
                  "emailMessage/To": "@parameters('PFM e-mail (pfm_PfmEmail)')",
                  "emailMessage/Subject": "@concat('90161Z flow failed: F05 Endorsement Routing r2', concat(', item ', string(triggerBody()?['ID'])))",
                  "emailMessage/Body": "@concat('<p>The flow F05 Endorsement Routing r2 stopped on a failed step.</p><p>Run: ', workflow()?['run']?['name'], '</p><ul>', join(body('Failed_text'), ''), '</ul><p>Fix the cause, then open the run in the run history and select Resubmit. A resubmitted run does not repeat what the failed run already did.</p>')",
                  "emailMessage/Importance": "High"
                }
              }
            },
            "End_as_failed": {
              "runAfter": {
                "Send_failure_e-mail": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "StepFailed",
                  "message": "A step failed; the PFM was e-mailed."
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
