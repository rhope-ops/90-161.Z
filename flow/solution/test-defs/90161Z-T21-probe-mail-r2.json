      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe",
          "item/Title": "RESULT",
          "item/ProbeTest": "T9",
          "item/ProbeWay": "S6",
          "item/ProbeResult": "@if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), 'FAIL', if(equals(actions('S6')?['status'], 'Succeeded'), 'PASS', 'FAIL'))",
          "item/ProbeDetail": "@if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), 'sent=no (the Shared mailbox value is empty)', concat('sent=', actions('S6')?['status'], '; status=', if(equals(actions('S6')?['outputs']?['statusCode'], null), 'none', string(actions('S6')?['outputs']?['statusCode']))))"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "READ1_delay": {
      "runAfter": {
        "Has_box": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "S3": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "S5": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "type": "Wait",
      "inputs": {
        "interval": {
