{
  "displayName": "90161Z T21 Probe Mail r1",
  "description": "R26 probe (task T21, fake data only). On a RUN-MAIL row in the probe list: sends three fake [TEST] e-mails to the flow owner (S1 shared-mailbox action, S2 send with From = the shared mailbox, S3 plain send), then after 2 and 8 minutes reads the inbox, junk and sent folders by Graph for the tag and writes RESULT rows T9 S1..S3, READ1, READ2 (subjects only, no address or body). Environment variable: Site URL, Shared mailbox.",
  "connections": [
    "shared_sharepointonline",
    "shared_office365",
    "shared_office365users"
  ],
  "triggers": {
    "When_an_item_is_created": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "conditions": [
        {
          "expression": "@startsWith(triggerBody()?['Title'],'RUN-MAIL')"
        }
      ],
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnNewItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Profile": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users",
          "connectionName": "shared_office365users",
          "operationId": "MyProfile_V2"
        },
        "parameters": {
          "$select": "mail"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Tag": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@substring(triggerBody()?['Title'], 9)"
    },
    "Has_box": {
      "runAfter": {
        "Profile": [
          "Succeeded"
        ],
        "Tag": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "equals": [
          "@empty(parameters('Shared mailbox (pfm_SharedMailbox)'))",
          false
        ]
      },
      "actions": {
        "S1": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('Shared mailbox (pfm_SharedMailbox)')",
              "emailMessage/To": "@body('Profile')?['mail']",
              "emailMessage/Subject": "@concat('[TEST] 90161Z T9 S1 ', outputs('Tag'))",
              "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "S2": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@body('Profile')?['mail']",
              "emailMessage/Subject": "@concat('[TEST] 90161Z T9 S2 ', outputs('Tag'))",
              "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>",
              "emailMessage/From": "@parameters('Shared mailbox (pfm_SharedMailbox)')"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "S3": {
      "runAfter": {
        "Profile": [
          "Succeeded"
        ],
        "Tag": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "parameters": {
          "emailMessage/To": "@body('Profile')?['mail']",
          "emailMessage/Subject": "@concat('[TEST] 90161Z T9 S3 ', outputs('Tag'))",
          "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "S1_row": {
      "runAfter": {
        "Has_box": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe",
          "item/Title": "RESULT",
          "item/ProbeTest": "T9",
          "item/ProbeWay": "S1",
          "item/ProbeResult": "@if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), 'FAIL', if(equals(actions('S1')?['status'], 'Succeeded'), 'PASS', 'FAIL'))",
          "item/ProbeDetail": "@if(empty(parameters('Shared mailbox (pfm_SharedMailbox)')), 'shared mailbox value empty', concat('sent=', actions('S1')?['status'], '; status=', if(equals(actions('S1')?['outputs']?['statusCode'], null), 'none', string(actions('S1')?['outputs']?['statusCode']))))"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "S2_row": {
      "runAfter": {
        "Has_box": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
