{
  "displayName": "90161Z T21 Probe Mail r2",
  "description": "R26 r2 probe (task T21, fake data only). On a RUN-MAIL row in the probe list: sends 3 fake e-mails to the flow owner with the same body: S3 from the owner mailbox with \"[TEST]\" at the start of the subject, S5 from the owner mailbox with no \"[TEST]\", S6 from the shared mailbox with no \"[TEST]\" (only when the Shared mailbox value is set). After 2, 8 and 25 minutes it reads the inbox, junk and sent folders by Graph for the tag and writes RESULT rows T9 S3, S5, S6, READ1, READ2, READ3 (where each tag was found; no address or body). Environment variable: Site URL, Shared mailbox.",
  "connections": [
    "shared_sharepointonline",
    "shared_office365",
    "shared_office365users"
  ],
  "triggers": {
    "When_an_item_is_created": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "conditions": [
        {
          "expression": "@startsWith(triggerBody()?['Title'],'RUN-MAIL')"
        }
      ],
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnNewItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Profile": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users",
          "connectionName": "shared_office365users",
          "operationId": "MyProfile_V2"
        },
        "parameters": {
          "$select": "mail"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Tag": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@substring(triggerBody()?['Title'], 9)"
    },
    "S3": {
      "runAfter": {
        "Profile": [
          "Succeeded"
        ],
        "Tag": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "parameters": {
          "emailMessage/To": "@body('Profile')?['mail']",
          "emailMessage/Subject": "@concat('[TEST] 90161Z T9 S3 ', outputs('Tag'))",
          "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "S5": {
      "runAfter": {
        "Profile": [
          "Succeeded"
        ],
        "Tag": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "parameters": {
          "emailMessage/To": "@body('Profile')?['mail']",
          "emailMessage/Subject": "@concat('90161Z T9 S5 ', outputs('Tag'))",
          "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Has_box": {
      "runAfter": {
        "Profile": [
          "Succeeded"
        ],
        "Tag": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "equals": [
          "@empty(parameters('Shared mailbox (pfm_SharedMailbox)'))",
          false
        ]
      },
      "actions": {
        "S6": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('Shared mailbox (pfm_SharedMailbox)')",
              "emailMessage/To": "@body('Profile')?['mail']",
              "emailMessage/Subject": "@concat('90161Z T9 S6 ', outputs('Tag'))",
              "emailMessage/Body": "<p>90-161.Z probe test message (fake content).</p>"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "S3_row": {
      "runAfter": {
        "S3": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe",
          "item/Title": "RESULT",
          "item/ProbeTest": "T9",
          "item/ProbeWay": "S3",
          "item/ProbeResult": "@if(equals(actions('S3')?['status'], 'Succeeded'), 'PASS', 'FAIL')",
          "item/ProbeDetail": "@concat('sent=', actions('S3')?['status'], '; status=', if(equals(actions('S3')?['outputs']?['statusCode'], null), 'none', string(actions('S3')?['outputs']?['statusCode'])))"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "S5_row": {
      "runAfter": {
        "S5": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "90161Z Probe",
          "item/Title": "RESULT",
          "item/ProbeTest": "T9",
          "item/ProbeWay": "S5",
          "item/ProbeResult": "@if(equals(actions('S5')?['status'], 'Succeeded'), 'PASS', 'FAIL')",
          "item/ProbeDetail": "@concat('sent=', actions('S5')?['status'], '; status=', if(equals(actions('S5')?['outputs']?['statusCode'], null), 'none', string(actions('S5')?['outputs']?['statusCode'])))"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "S6_row": {
