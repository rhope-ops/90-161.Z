{
  "displayName": "90161Z T17 Solution Import Test A r4",
  "description": "R18 test A r4 (PFM 14 Nov 26; r3 failed in R17: workflow not declared as a root component; r4 writes the GUID lowercase): a solution with one flow and one SharePoint connection reference and NO environment variable. The site address is a run input. Reads the row count of PFM Settings and writes one result file 90161Z-T17-solution-result-a-r4.txt to the site's default document library. Changes nothing else.",
  "connections": [
    "shared_sharepointonline"
  ],
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": "Site address",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "The new site address",
              "x-ms-content-hint": "TEXT"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    }
  },
  "actions": {
    "Read_settings_count": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@triggerBody()?['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFM Settings')?$select=ItemCount",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          }
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Write_result_file": {
      "runAfter": {
        "Read_settings_count": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@triggerBody()?['text']",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/DefaultDocumentLibrary/RootFolder/Files/add(url='90161Z-T17-solution-result-a-r4.txt',overwrite=true)",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          },
          "parameters/body": "@{concat('SOLUTION A import=OK connection-reference=OK environment-variable=none settings-read-status=', string(outputs('Read_settings_count')?['statusCode']), ' settings-rows=', string(coalesce(body('Read_settings_count')?['ItemCount'], 'none')), ' run-utc=', utcNow())}"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "variant": "A"
}
